{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/spots.mjs": {
            "regions": [
                "cdg1"
            ]
        },
        "api/place-search.mjs": {
            "regions": [
                "cdg1"
            ]
        },
        "api/place-details.mjs": {
            "regions": [
                "cdg1"
            ]
        }
    }
}